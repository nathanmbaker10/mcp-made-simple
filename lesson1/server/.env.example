# Copy to .env for your own notes. The HTTP server reads the process environment;
# it does not load this file by itself. On Render, set MCP_AUTH_TOKEN in the dashboard.
#
# Generate a token:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

MCP_AUTH_TOKEN=replace-with-a-long-random-string
PORT=3000
